<?xml version="1.0" encoding="UTF-8"?>
<!-- V24: dịch vụ tra cứu qua SOAP, bằng Jakarta XML Web Services (Metro, bản hiện thực tham chiếu). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>netlab</groupId>
  <artifactId>v24-soap</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- JDK 11 trở đi không còn kèm JAX-WS: dùng Metro, hiện thực Jakarta XML Web Services 4.0 -->
    <dependency>
      <groupId>com.sun.xml.ws</groupId>
      <artifactId>jaxws-rt</artifactId>
      <version>4.0.5</version>
    </dependency>
  </dependencies>
</project>
